# =====================================================================
# Pomera DM250 OpenBSD Installer User Configuration Preset
# Copy this file to "configs/user_config.env" to customize your setup.
# =====================================================================

# 1. User & Hostname Configuration
POMERA_USERNAME="pomera"             # User login name to create (Default: pomera)
POMERA_HOSTNAME="pomera"             # System hostname (Default: pomera)
POMERA_TIMEZONE="Asia/Tokyo"         # System timezone (Default: Asia/Tokyo)

# 2. Account Passwords
POMERA_ROOT_PASSWORD="pomera"        # Root password (Default: pomera)
POMERA_USER_PASSWORD="pomera"        # User password (Default: pomera)

# 3. Security & Remote Access
POMERA_ENABLE_SSHD="yes"             # Start OpenSSH daemon on boot (yes / no)
POMERA_ALLOW_ROOT_SSH="no"           # Allow root SSH login (no / prohibit-password / yes)
POMERA_CONFIRM_INSTALL="yes"         # Prompt for confirmation before erasing internal eMMC (yes / no)

# 4. Wi-Fi Networks (Multiple SSIDs supported - 2.4GHz Only)
# Format: "SSID:PASSWORD" (separated by newlines)
# OpenBSD will automatically scan and connect to the strongest available network!
POMERA_WIFI_NETWORKS="
SSID-example1:PASSWORD-example1
SSID-example2:PASSWORD-example2
"

# 5. Bootloader Configuration
POMERA_BOOT_TIMEOUT="5"              # Boot countdown delay in seconds (Default: 5)

# 6. Power & Lid Management (pomera_lid_watch daemon)
# Polling interval in seconds to check lid open/close state (Default: 0.5)
# Can be changed later anytime via: doas rcctl set pomera_lid_watch flags "-i 0.5 -p auto"
POMERA_LID_INTERVAL="0.5"

# CPU Performance Policy on Lid Open / Normal operation (auto / 100 / high, Default: auto)
# - auto: Dynamically scales CPU clock frequency based on load (recommended for battery life)
# - 100 / high: Locks CPU at 100% maximum clock frequency at all times
POMERA_CPU_POLICY="auto"

# 7. Hardware Patches & Kernel Recompilation (Optional)
# Automatically inspects jcs.org kernel binary:
# - If already fixed upstream, uses the official kernel directly (0s rebuild time).
# - If not yet fixed, automatically rebuilds patched kernel via QEMU (~15-30 mins).
# Options: "yes" / "no" (Default: "no")
POMERA_SMART_KERNEL="no"      # Optimize kernel by removing unused SoCs & PCI drivers (~25% smaller) [yes / no]
POMERA_PATCH_USB_HUB="no"     # Fix USB Hub crash & disconnect issues [yes / no]
POMERA_PATCH_X11_KEYS="no"    # Fix Right-Shift and Left-Alt keys under X11 [yes / no]

# Note: Root disk encryption (softraid CRYPTO) is disabled because the OpenBSD
# armv7 (32-bit ARM) EFI bootloader (BOOTARM.EFI) does not support crypto boot.
