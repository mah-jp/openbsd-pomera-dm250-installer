+extern int mlterm_fb_sync;
+void ui_display_sync(ui_display_t *disp) {
+  /*
+   * DECSET 2026 Synchronized Output:
+   * CSI ? 2026 h sets mlterm_fb_sync = 1.
+   * CSI ? 2026 l clears mlterm_fb_sync = 0.
+   * While mlterm_fb_sync == 1, blits to physical framebuffer are deferred
+   * so that full application frames render atomically without partial-frame flicker.
+   * A 500ms safety timeout ensures that a crashing app cannot leave the display frozen.
+   */
+  static struct timeval bsu_start = {0, 0};
+  if (mlterm_fb_sync) {
+    struct timeval now;
+    gettimeofday(&now, NULL);
+    if (bsu_start.tv_sec == 0) {
+      bsu_start = now;
+      return;
+    }
+    long elapsed_ms = (now.tv_sec - bsu_start.tv_sec) * 1000 +
+                      (now.tv_usec - bsu_start.tv_usec) / 1000;
+    if (elapsed_ms < 500) {
+      return;
+    }
+    mlterm_fb_sync = 0;
+  }
+  bsu_start.tv_sec = 0;
+  bsu_start.tv_usec = 0;
+
+  if (_display.real_fb && _display.fb_dirty) {
+    int min_y = _display.dirty_min_y;
+    int max_y = _display.dirty_max_y;
+    if (min_y < 0) min_y = 0;
+    if (max_y >= _disp.height) max_y = _disp.height - 1;
+    if (min_y <= max_y) {
+      if (min_y == 0 && max_y == _disp.height - 1) {
+        memcpy(_display.real_fb, _display.fb, _display.smem_len);
+      } else {
+        size_t offset = (size_t)min_y * _display.line_length;
+        size_t bytes = (size_t)(max_y - min_y + 1) * _display.line_length;
+        if (offset + bytes > _display.smem_len) {
+          bytes = (offset < _display.smem_len) ? (_display.smem_len - offset) : 0;
+        }
+        if (bytes > 0) {
+          memcpy(_display.real_fb + offset, _display.fb + offset, bytes);
+        }
+      }
+    }
+    _display.fb_dirty = 0;
+    _display.dirty_min_y = _disp.height;
+    _display.dirty_max_y = -1;
+  }
+}
