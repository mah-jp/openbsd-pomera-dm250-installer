+#define ROW_ALIGN 24
+#define SAFETY_MARGIN 4
+
+static inline void mark_dirty(int y, int height) {
+  int cur_y = _display.yoffset + y;
+  int end_y = cur_y + height - 1;
+
+  /* Fast-path: already fully covered by current dirty row bounds */
+  if (_display.fb_dirty && cur_y >= _display.dirty_min_y && end_y <= _display.dirty_max_y) {
+    return;
+  }
+
+  cur_y -= SAFETY_MARGIN;
+  end_y += SAFETY_MARGIN;
+
+  if (cur_y < 0) cur_y = 0;
+  if (end_y >= _disp.height) end_y = _disp.height - 1;
+
+  int row_min = (cur_y / ROW_ALIGN) * ROW_ALIGN;
+  int row_max = ((end_y + ROW_ALIGN) / ROW_ALIGN) * ROW_ALIGN - 1;
+
+  if (row_min < 0) row_min = 0;
+  if (row_max >= _disp.height) row_max = _disp.height - 1;
+
+  _display.fb_dirty = 1;
+  if (row_min < _display.dirty_min_y) _display.dirty_min_y = row_min;
+  if (row_max > _display.dirty_max_y) _display.dirty_max_y = row_max;
+}
+
 static inline u_char *get_fb(int x, int y) {
+  mark_dirty(y, 1);
   return _display.fb_base + (_display.yoffset + y) * _display.line_length +
          (_display.xoffset + x) * _display.bytes_per_pixel / _display.pixels_per_byte;
 }
