+extern int mlterm_fb_sync;
+void ui_display_sync(ui_display_t *disp) {
+  static struct timeval bsu_since = {0, 0};
+  if (mlterm_fb_sync) {
+    struct timeval now;
+    gettimeofday(&now, NULL);
+    if (bsu_since.tv_sec == 0 && bsu_since.tv_usec == 0) {
+      bsu_since = now;
+      return;
+    }
+    if ((now.tv_sec - bsu_since.tv_sec) * 1000 +
+        (now.tv_usec - bsu_since.tv_usec) / 1000 < 60) {
+      return;
+    }
+    mlterm_fb_sync = 0;
+  }
+  bsu_since.tv_sec = 0;
+  bsu_since.tv_usec = 0;
+  if (_display.real_fb && _display.fb_dirty) {
+    int min_y = _display.dirty_min_y;
+    int max_y = _display.dirty_max_y;
+    if (min_y < 0) min_y = 0;
+    if (max_y >= _disp.height) max_y = _disp.height - 1;
+    if (min_y <= max_y) {
+      size_t offset = (size_t)min_y * _display.line_length;
+      size_t bytes = (size_t)(max_y - min_y + 1) * _display.line_length;
+      if (offset + bytes > _display.smem_len) {
+        bytes = (offset < _display.smem_len) ? (_display.smem_len - offset) : 0;
+      }
+      if (bytes > 0) {
+        memcpy(_display.real_fb + offset, _display.fb + offset, bytes);
+      }
+    }
+    _display.fb_dirty = 0;
+    _display.dirty_min_y = _disp.height;
+    _display.dirty_max_y = -1;
+  }
+}
